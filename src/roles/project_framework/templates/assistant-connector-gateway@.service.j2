[Unit]
Description=Identity-scoped connector gateway for project %i
PartOf=assistant-connector@%i.target
Requires=assistant-connector-broker@%i.service
After=assistant-connector-broker@%i.service
[Service]
Environment={{ ('HOME=' + assistant_runtime_home) | replace('%', '%%') | to_json }}
Environment={{ ('AC_AGENTS_ROOT=' + assistant_install_root) | replace('%', '%%') | to_json }}
Environment=ASSISTANT_PROJECT=%i
UMask=0077
ExecStart={{ (assistant_connector_root + '/routing/connector-team.py') | replace('%', '%%') | to_json }} gateway
Restart=on-failure
RestartSec=2
