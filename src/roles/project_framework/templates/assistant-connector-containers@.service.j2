[Unit]
Description=Eight native harness sessions for project %i
PartOf=assistant-connector@%i.target
Requires=assistant-connector-gateway@%i.service
After=assistant-connector-gateway@%i.service
[Service]
Environment=HOME={{ __project_framework_home }}
Environment=ASSISTANT_PROJECT=%i
Environment=XDG_RUNTIME_DIR=/run/user/{{ __project_framework_uid }}
Type=oneshot
RemainAfterExit=yes
KillMode=process
UMask=0077
ExecStart={{ __project_framework_home }}/agents-connector/routing/project-team.py launch-all %i
ExecStop={{ __project_framework_home }}/agents-connector/routing/project-team.py stop-containers %i
ExecStopPost={{ __project_framework_home }}/agents-connector/routing/project-team.py stop-containers %i
TimeoutStartSec=180
TimeoutStopSec=90
