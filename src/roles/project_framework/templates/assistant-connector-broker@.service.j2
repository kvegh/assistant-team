[Unit]
Description=Stock connector broker for project %i
PartOf=assistant-connector@%i.target
[Service]
Environment={{ ('HOME=' + assistant_runtime_home) | replace('%', '%%') | to_json }}
Environment={{ ('AC_AGENTS_ROOT=' + assistant_install_root) | replace('%', '%%') | to_json }}
Environment=ASSISTANT_PROJECT=%i
Environment={{ ('PATH=' + assistant_connector_root + '/routing:/usr/bin:/bin') | replace('%', '%%') | to_json }}
UMask=0077
ExecStartPre={{ (assistant_connector_root + '/routing/project-team.py') | replace('%', '%%') | to_json }} preflight %i
ExecStart={{ (assistant_connector_root + '/bin/agents-connector') | replace('%', '%%') | to_json }} broker --socket {{ ((assistant_install_root | replace('%', '%%')) + '/projects/%i/broker.sock') | to_json }} --db {{ ((assistant_install_root | replace('%', '%%')) + '/projects/%i/db.sqlite') | to_json }} --session %i
ExecStartPost={{ (assistant_connector_root + '/routing/connector-team.py') | replace('%', '%%') | to_json }} init
Restart=on-failure
RestartSec=2
