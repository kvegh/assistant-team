[Unit]
Description=Stock connector broker for project %i
PartOf=assistant-connector@%i.target
[Service]
Environment=HOME={{ __project_framework_home }}
Environment=ASSISTANT_PROJECT=%i
Environment=PATH={{ __project_framework_home }}/agents-connector/routing:/usr/bin:/bin
UMask=0077
ExecStartPre={{ __project_framework_home }}/agents-connector/routing/project-team.py preflight %i
ExecStart={{ __project_framework_home }}/agents-connector/bin/agents-connector broker --socket {{ __project_framework_home }}/projects/%i/broker.sock --db {{ __project_framework_home }}/projects/%i/db.sqlite --session %i
ExecStartPost={{ __project_framework_home }}/agents-connector/routing/connector-team.py init
Restart=on-failure
RestartSec=2
